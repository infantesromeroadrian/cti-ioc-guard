# Copy to .env (never commit .env). No values here are real.

APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./threat_intel.db

# --- Optional live feeds (the system runs offline with fixtures without these) ---
NVD_API_KEY=
OTX_API_KEY=

# --- LLM extractor ---
# provider: ollama (native client, default) | openai_compat (any /v1/chat/completions server)
LLM_PROVIDER=ollama
LLM_MODEL=gpt-oss:120b-cloud
# Local daemon by default. For Ollama Cloud direct: https://ollama.com + OLLAMA_API_KEY
OLLAMA_HOST=http://localhost:11434
OLLAMA_API_KEY=
# Only for openai_compat
LLM_BASE_URL=
LLM_API_KEY=
LLM_MAX_OUTPUT_TOKENS=2048
LLM_TIMEOUT_SECONDS=120

# --- API ---
API_CORS_ORIGINS=http://localhost:8000
